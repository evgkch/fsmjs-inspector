{
  "idle": { "pick": [{ "to": "sending", "with": "begin", "emit": "send" }] },
  "sending": {
    "chunk": [{ "to": "sending", "with": "advance" }],
    "fail": [{ "to": "failed", "with": "record" }],
    "done": [{ "to": "uploaded", "with": "finish", "emit": "cheer" }],
    "cancel": [{ "to": "idle", "emit": "abort" }]
  },
  "failed": {
    "retry": [
      { "to": "sending", "when": "triesLeft", "with": "again", "emit": "send" },
      { "to": "failed", "with": "giveUp" }
    ],
    "cancel": [{ "to": "idle" }]
  },
  "uploaded": { "pick": [{ "to": "sending", "with": "begin", "emit": "send" }] }
}
