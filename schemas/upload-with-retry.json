{
  "idle": { "pick": [{ "to": ["sending", "begin"], "emit": "send" }] },
  "sending": {
    "chunk": [{ "to": ["sending", "advance"] }],
    "fail": [{ "to": ["failed", "record"] }],
    "done": [{ "to": ["uploaded", "finish"], "emit": "cheer" }],
    "cancel": [{ "to": "idle", "emit": "abort" }]
  },
  "failed": {
    "retry": [
      { "to": ["sending", "again"], "emit": "send", "when": "triesLeft" },
      { "to": ["failed", "giveUp"] }
    ],
    "cancel": [{ "to": "idle" }]
  },
  "uploaded": { "pick": [{ "to": ["sending", "begin"], "emit": "send" }] }
}
